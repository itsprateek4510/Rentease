PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/rentease?replicaSet=rentease-local
JWT_SECRET=change_this_secret
CLIENT_URL=http://localhost:5175
NODE_ENV=development
# Google Cloud Console: OAuth client type "Web application". Callback must match exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
# Optional SMTP for real emails (OTP codes and reset links). Without it, codes print in the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RentEase <no-reply@rentease.in>
# Optional: real SMS OTP through Twilio. Without these, phone OTP codes print in the server console.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
